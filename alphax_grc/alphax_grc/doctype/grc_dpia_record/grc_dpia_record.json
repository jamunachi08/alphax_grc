 "fields": [
  {"fieldname": "section_identity", "fieldtype": "Section Break", "label": "Identity"},
  {"fieldname": "dpia_title", "fieldtype": "Data", "label": "DPIA Title",
   "reqd": 1, "in_list_view": 1, "in_global_search": 1,
   "description": "e.g. 'New CRM with customer marketing analytics'"},
  {"fieldname": "client", "fieldtype": "Link", "options": "GRC Client Profile",
   "label": "Client", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
  {"fieldname": "engagement", "fieldtype": "Link", "options": "GRC Engagement",
   "label": "Engagement", "in_standard_filter": 1},
  {"fieldname": "linked_processing_activity", "fieldtype": "Data",
   "label": "Linked Processing Activity",
   "description": "Reference to RoPA entry, system name, or project ID"},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status",
   "options": "Draft\nIn Review\nApproved\nRejected\nNeeds Revision\nRetired",
   "default": "Draft", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "dpia_date", "fieldtype": "Date", "label": "DPIA Date",
   "default": "Today", "reqd": 1, "in_list_view": 1},
  {"fieldname": "next_review_due", "fieldtype": "Date",
   "label": "Next Review Due"},

  {"fieldname": "trigger_section", "fieldtype": "Section Break", "label": "Trigger"},
  {"fieldname": "trigger_reason", "fieldtype": "Select", "label": "Trigger Reason",
   "options": "\nNew system processing personal data\nNew processing activity in existing system\nProcessing of sensitive personal data\nLarge-scale systematic monitoring\nAutomated decision-making with legal effects\nNew technology with privacy implications\nCross-border transfer\nPeriodic review\nMaterial change to existing processing",
   "reqd": 1, "in_standard_filter": 1},
  {"fieldname": "is_high_risk", "fieldtype": "Check", "label": "High-Risk Processing",
   "default": "0", "in_list_view": 1, "in_standard_filter": 1,
   "description": "If checked, DPIA is mandatory per PDPL Implementing Regulation"},

  {"fieldname": "section_processing", "fieldtype": "Section Break",
   "label": "Processing Description"},
  {"fieldname": "processing_description", "fieldtype": "Text Editor",
   "label": "Description of Processing",
   "reqd": 1,
   "description": "Purpose, scope, nature, context"},
  {"fieldname": "data_categories", "fieldtype": "Small Text",
   "label": "Personal Data Categories",
   "description": "What data elements are processed"},
  {"fieldname": "data_subject_categories", "fieldtype": "Small Text",
   "label": "Data Subject Categories",
   "description": "Customers, employees, prospects, minors, etc."},
  {"fieldname": "column_break_2", "fieldtype": "Column Break"},
  {"fieldname": "lawful_basis", "fieldtype": "Select", "label": "Lawful Basis",
   "options": "\nConsent\nContract\nLegal Obligation\nVital Interest\nPublic Interest\nLegitimate Interest"},
  {"fieldname": "retention_period", "fieldtype": "Data",
   "label": "Retention Period"},
  {"fieldname": "data_volume", "fieldtype": "Select", "label": "Data Volume",
   "options": "\nSmall (<1k records)\nMedium (1k-100k)\nLarge (100k-1M)\nVery Large (>1M)"},

  {"fieldname": "section_necessity", "fieldtype": "Section Break",
   "label": "Necessity & Proportionality"},
  {"fieldname": "necessity_assessment", "fieldtype": "Text Editor",
   "label": "Necessity Assessment",
   "description": "Why is this processing necessary for the stated purpose?"},
  {"fieldname": "proportionality_assessment", "fieldtype": "Text Editor",
   "label": "Proportionality Assessment",
   "description": "Is the data processed proportionate to the purpose?"},
  {"fieldname": "column_break_3", "fieldtype": "Column Break"},
  {"fieldname": "alternative_options_considered", "fieldtype": "Text Editor",
   "label": "Alternative Options Considered",
   "description": "What less-intrusive alternatives were considered and why rejected"},

  {"fieldname": "section_risk", "fieldtype": "Section Break",
   "label": "Risk Assessment"},
  {"fieldname": "risk_to_individuals", "fieldtype": "Text Editor",
   "label": "Risks to Individuals",
   "description": "What could go wrong for the data subjects"},
  {"fieldname": "likelihood", "fieldtype": "Select", "label": "Likelihood",
   "options": "Very Low\nLow\nMedium\nHigh\nVery High",
   "default": "Medium", "in_standard_filter": 1},
  {"fieldname": "impact", "fieldtype": "Select", "label": "Impact",
   "options": "Very Low\nLow\nMedium\nHigh\nVery High",
   "default": "Medium", "in_standard_filter": 1},
  {"fieldname": "column_break_4", "fieldtype": "Column Break"},
  {"fieldname": "inherent_risk_level", "fieldtype": "Select",
   "label": "Inherent Risk Level",
   "options": "Low\nModerate\nHigh\nVery High",
   "in_list_view": 1, "in_standard_filter": 1, "read_only": 1,
   "description": "Auto-derived from likelihood × impact"},
  {"fieldname": "mitigations_planned", "fieldtype": "Text Editor",
   "label": "Mitigations Planned"},
  {"fieldname": "residual_risk_level", "fieldtype": "Select",
   "label": "Residual Risk Level",
   "options": "\nLow\nModerate\nHigh\nVery High", "in_standard_filter": 1},

  {"fieldname": "section_consultation", "fieldtype": "Section Break",
   "label": "Consultation", "collapsible": 1},
  {"fieldname": "dpo_consulted", "fieldtype": "Check",
   "label": "DPO Consulted", "default": "0"},
  {"fieldname": "stakeholders_consulted", "fieldtype": "Small Text",
   "label": "Stakeholders Consulted",
   "description": "IT, Legal, Business, Security, etc."},
  {"fieldname": "data_subjects_consulted", "fieldtype": "Small Text",
   "label": "Data Subjects Consulted (if applicable)"},

  {"fieldname": "section_decision", "fieldtype": "Section Break", "label": "Decision"},
  {"fieldname": "decision", "fieldtype": "Select", "label": "Decision",
   "options": "\nProceed\nProceed with Conditions\nDo Not Proceed\nDefer Pending Information",
   "in_standard_filter": 1, "in_list_view": 1},
  {"fieldname": "decision_made_by", "fieldtype": "Link", "options": "User",
   "label": "Decision Made By"},
  {"fieldname": "column_break_5", "fieldtype": "Column Break"},
  {"fieldname": "decision_date", "fieldtype": "Date", "label": "Decision Date"},
  {"fieldname": "decision_rationale", "fieldtype": "Text Editor",
   "label": "Decision Rationale"},

  {"fieldname": "section_links", "fieldtype": "Section Break",
   "label": "Cross-References", "collapsible": 1},
  {"fieldname": "linked_pdpl_articles", "fieldtype": "Small Text",
   "label": "Linked PDPL Articles"},
  {"fieldname": "linked_dsars", "fieldtype": "Small Text",
   "label": "Related DSAR Requests"},
  {"fieldname": "linked_findings", "fieldtype": "Small Text",
   "label": "Related Audit Findings"}
 ],
