{
 "actions": [],
 "allow_rename": 1,
 "autoname": "format:CRQ-{####}",
 "creation": "2026-05-10 00:00:00",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "section_identity",
  "scenario_name",
  "client",
  "engagement",
  "linked_risk",
  "column_break_1",
  "framework",
  "control_reference",
  "asset_at_risk",
  "is_active",

  "section_threat",
  "threat_event_name",
  "threat_actor_type",
  "threat_capability",
  "column_break_2",
  "contact_frequency_per_year",
  "threat_event_frequency",

  "section_vulnerability",
  "vulnerability_summary",
  "control_strength",
  "column_break_3",
  "vulnerability_factor",
  "loss_event_frequency",

  "section_loss",
  "loss_categories",
  "loss_min",
  "loss_most_likely",
  "loss_max",
  "column_break_4",
  "single_loss_expectancy",
  "annual_loss_expectancy",
  "currency",

  "section_classification",
  "likelihood_band",
  "impact_band",
  "column_break_5",
  "inherent_risk_rating",
  "residual_risk_rating",

  "section_treatment",
  "treatment_recommendation",
  "treatment_notes",
  "section_meta",
  "scenario_owner",
  "last_reviewed",
  "next_review_due"
 ],
 "fields": [
  {"fieldname": "section_identity", "fieldtype": "Section Break", "label": "Identity"},
  {"fieldname": "scenario_name", "fieldtype": "Data", "label": "Scenario Name",
   "reqd": 1, "in_list_view": 1, "in_global_search": 1,
   "description": "e.g. 'Ransomware on payment processing systems'"},
  {"fieldname": "client", "fieldtype": "Link", "options": "GRC Client Profile",
   "label": "Client", "reqd": 1, "in_list_view": 1,
   "in_standard_filter": 1, "search_index": 1},
  {"fieldname": "engagement", "fieldtype": "Link", "options": "GRC Engagement",
   "label": "Engagement", "in_standard_filter": 1},
  {"fieldname": "linked_risk", "fieldtype": "Link", "options": "GRC Risk Register",
   "label": "Linked Risk", "in_standard_filter": 1,
   "description": "Optional: link this scenario to a qualitative risk in the register"},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "framework", "fieldtype": "Select", "label": "Framework Context",
   "options": "\nNCA ECC-2:2024\nISO 27001\nISO 42001\nNIST CSF 2.0\nISO 22301\nAramco SACS-002\nPDPL\nGDPR\nFAIR (Standalone)\nNIST SP 800-30",
   "in_standard_filter": 1},
  {"fieldname": "control_reference", "fieldtype": "Data",
   "label": "Control Reference"},
  {"fieldname": "asset_at_risk", "fieldtype": "Data", "label": "Asset / System at Risk",
   "description": "What's exposed in this scenario"},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Active",
   "default": "1", "in_standard_filter": 1},

  {"fieldname": "section_threat", "fieldtype": "Section Break",
   "label": "Threat Event Frequency (FAIR)",
   "description": "How often a threat actor is likely to act against this asset"},
  {"fieldname": "threat_event_name", "fieldtype": "Data", "label": "Threat Event"},
  {"fieldname": "threat_actor_type", "fieldtype": "Select", "label": "Threat Actor Type",
   "options": "\nNation State\nOrganized Crime\nCybercriminal\nHacktivist\nInsider — Malicious\nInsider — Negligent\nCompetitor\nPhysical Threat\nNatural / Environmental\nOther"},
  {"fieldname": "threat_capability", "fieldtype": "Select", "label": "Threat Capability",
   "options": "Very Low\nLow\nMedium\nHigh\nVery High",
   "default": "Medium",
   "description": "FAIR threat capability rating"},
  {"fieldname": "column_break_2", "fieldtype": "Column Break"},
  {"fieldname": "contact_frequency_per_year", "fieldtype": "Float",
   "label": "Contact Frequency (per year)", "default": 0,
   "description": "How many times per year does the threat actor contact this asset?"},
  {"fieldname": "threat_event_frequency", "fieldtype": "Float",
   "label": "Threat Event Frequency", "read_only": 1, "in_list_view": 1,
   "description": "Auto-computed: contact_frequency × threat_capability_factor"},

  {"fieldname": "section_vulnerability", "fieldtype": "Section Break",
   "label": "Vulnerability",
   "description": "Probability that a threat event becomes a loss event"},
  {"fieldname": "vulnerability_summary", "fieldtype": "Small Text",
   "label": "Vulnerability Description"},
  {"fieldname": "control_strength", "fieldtype": "Select", "label": "Control Strength",
   "options": "Very Low\nLow\nMedium\nHigh\nVery High",
   "default": "Medium",
   "description": "How strong are existing controls against this threat?"},
  {"fieldname": "column_break_3", "fieldtype": "Column Break"},
  {"fieldname": "vulnerability_factor", "fieldtype": "Percent",
   "label": "Vulnerability %", "read_only": 1,
   "description": "Auto-computed from threat_capability vs control_strength"},
  {"fieldname": "loss_event_frequency", "fieldtype": "Float",
   "label": "Loss Event Frequency", "read_only": 1, "in_list_view": 1,
   "description": "Auto-computed: TEF × vulnerability_factor"},

  {"fieldname": "section_loss", "fieldtype": "Section Break",
   "label": "Loss Magnitude (FAIR 3-point estimate)",
   "description": "PERT-beta approximation: SLE = (min + 4*ml + max) / 6"},
  {"fieldname": "loss_categories", "fieldtype": "Small Text",
   "label": "Loss Categories",
   "description": "Productivity / Response / Replacement / Fines / Reputation / Competitive Advantage"},
  {"fieldname": "loss_min", "fieldtype": "Currency", "label": "Loss Minimum",
   "default": 0,
   "description": "Best-case loss if event occurs"},
  {"fieldname": "loss_most_likely", "fieldtype": "Currency",
   "label": "Loss Most Likely", "default": 0, "in_list_view": 1,
   "description": "Most probable loss"},
  {"fieldname": "loss_max", "fieldtype": "Currency", "label": "Loss Maximum",
   "default": 0,
   "description": "Worst-case loss"},
  {"fieldname": "column_break_4", "fieldtype": "Column Break"},
  {"fieldname": "single_loss_expectancy", "fieldtype": "Currency",
   "label": "Single Loss Expectancy", "read_only": 1,
   "description": "Auto-computed: PERT-beta = (min + 4*most_likely + max) / 6"},
  {"fieldname": "annual_loss_expectancy", "fieldtype": "Currency",
   "label": "Annual Loss Expectancy", "read_only": 1, "in_list_view": 1,
   "description": "Auto-computed: SLE × Loss Event Frequency"},
  {"fieldname": "currency", "fieldtype": "Link", "options": "Currency",
   "label": "Currency", "default": "SAR"},

  {"fieldname": "section_classification", "fieldtype": "Section Break",
   "label": "Risk Classification (NIST SP 800-30 5×5 matrix)"},
  {"fieldname": "likelihood_band", "fieldtype": "Select", "label": "Likelihood",
   "options": "Very Low\nLow\nMedium\nHigh\nVery High",
   "in_standard_filter": 1, "read_only": 1,
   "description": "Auto-classified from loss_event_frequency"},
  {"fieldname": "impact_band", "fieldtype": "Select", "label": "Impact",
   "options": "Very Low\nLow\nMedium\nHigh\nVery High",
   "in_standard_filter": 1, "read_only": 1,
   "description": "Auto-classified from single_loss_expectancy"},
  {"fieldname": "column_break_5", "fieldtype": "Column Break"},
  {"fieldname": "inherent_risk_rating", "fieldtype": "Select",
   "label": "Inherent Risk", "in_list_view": 1, "in_standard_filter": 1,
   "options": "Low\nModerate\nHigh\nVery High",
   "read_only": 1,
   "description": "Auto-derived from likelihood × impact (NIST 800-30 matrix)"},
  {"fieldname": "residual_risk_rating", "fieldtype": "Select",
   "label": "Residual Risk", "in_standard_filter": 1,
   "options": "\nLow\nModerate\nHigh\nVery High",
   "description": "After applying additional treatments"},

  {"fieldname": "section_treatment", "fieldtype": "Section Break",
   "label": "Treatment", "collapsible": 1},
  {"fieldname": "treatment_recommendation", "fieldtype": "Select",
   "label": "Treatment", "options": "\nMitigate\nTransfer\nAvoid\nAccept",
   "in_standard_filter": 1},
  {"fieldname": "treatment_notes", "fieldtype": "Text Editor",
   "label": "Treatment Notes / Plan"},

  {"fieldname": "section_meta", "fieldtype": "Section Break",
   "label": "Metadata", "collapsible": 1},
  {"fieldname": "scenario_owner", "fieldtype": "Link", "options": "User",
   "label": "Scenario Owner"},
  {"fieldname": "last_reviewed", "fieldtype": "Date", "label": "Last Reviewed"},
  {"fieldname": "next_review_due", "fieldtype": "Date",
   "label": "Next Review Due"}
 ],
 "links": [],
