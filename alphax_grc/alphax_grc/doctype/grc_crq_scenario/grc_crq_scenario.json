  {"role": "GRC Executive", "read": 1, "write": 1, "report": 1, "export": 1},
  {"role": "Compliance Officer", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1},
  {"role": "GRC Assessor", "read": 1, "write": 1, "create": 1, "report": 1},
  {"role": "GRC Auditor", "read": 1, "report": 1, "export": 1}
 ],
