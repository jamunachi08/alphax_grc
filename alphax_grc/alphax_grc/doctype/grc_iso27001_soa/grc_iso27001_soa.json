  {"fieldname": "section_justification", "fieldtype": "Section Break",
   "label": "Justification & Remarks"},
  {"fieldname": "justification_for_inclusion_or_exclusion",
   "fieldtype": "Text Editor",
   "label": "Justification for Inclusion or Exclusion",
